# Copia este archivo a  .env  y coloca tus valores reales.
# NUNCA subas el archivo .env a un repositorio ni compartas tu clave.
#
# Este archivo de ejemplo no contiene ninguna clave real: es solo una plantilla.

# Clave de Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=TU_CLAVE_AQUI

# Modelo a usar (opcional). Por defecto: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Puerto y host del servidor local (opcional)
PORT=8787
HOST=127.0.0.1
